# Variables de entorno — CreatIA Web
# Copia este archivo como .env.local y completa los valores reales

# Email (Nodemailer via Gmail)
NODEMAILER_HOST=smtp.gmail.com
NODEMAILER_PORT=587
NODEMAILER_USER=your-email@gmail.com
NODEMAILER_PASS=your-gmail-app-password
CONTACT_EMAIL_TO=contacto@creatia.co

# WhatsApp (sin + ni espacios, ejemplo: 573001234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=573001234567
